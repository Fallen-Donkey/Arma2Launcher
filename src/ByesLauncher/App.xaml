<Application x:Class="ByesLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             xmlns:local="clr-namespace:ByesLauncher"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <sys:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <local:NullToVisibleConverter x:Key="NullToVisibleConverter"/>
            <local:NotNullConverter x:Key="NotNullConverter"/>
            <local:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>
            <local:JoinListConverter x:Key="JoinListConverter"/>
            <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <local:JoinButtonContentConverter x:Key="JoinButtonContentConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
