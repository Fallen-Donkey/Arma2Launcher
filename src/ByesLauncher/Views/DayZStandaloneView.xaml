<UserControl x:Class="ByesLauncher.Views.DayZStandaloneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8" Margin="0,0,0,8"
                Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
            <DockPanel>
                <ui:Button DockPanel.Dock="Left" Content="Refresh" Command="{Binding RefreshCommand}"
                           Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,0"/>
                <CheckBox DockPanel.Dock="Right" Content="1st-person only" IsChecked="{Binding FirstPersonOnly}" VerticalAlignment="Center" Margin="8,0"/>
                <CheckBox DockPanel.Dock="Right" Content="Hide empty" IsChecked="{Binding HideEmpty}" VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <ui:TextBox PlaceholderText="Filter DayZ Standalone servers..."
                            Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}" Margin="0,0,8,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding ServersView}"
                      SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      RowBackground="Transparent" AlternatingRowBackground="#181818"
                      Background="#141414" BorderBrush="#3A3A3A">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Server Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Map"     Binding="{Binding Map}"           Width="120"/>
                    <DataGridTextColumn Header="Players" Binding="{Binding PlayersDisplay}" Width="80"/>
                    <DataGridTextColumn Header="Ping"    Binding="{Binding Ping}"           Width="60"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

            <Border Grid.Column="2" Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Visibility="{Binding Selected, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding Selected.Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Selected.Endpoint}" Opacity="0.6" Margin="0,2,0,12"/>
                        <TextBlock Text="{Binding Selected.Map}" Margin="0,2"/>
                        <TextBlock Text="{Binding Selected.PlayersDisplay}" Margin="0,2"/>
                        <TextBlock Text="{Binding Selected.Version}" Opacity="0.7" Margin="0,2"/>
                    </StackPanel>
                    <TextBlock Grid.Row="0" Text="Select a server to see details."
                               Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Selected, Converter={StaticResource NullToVisibleConverter}}"/>
                    <ui:Button Grid.Row="2" Content="JOIN VIA STEAM" Appearance="Primary"
                               Command="{Binding JoinCommand}" HorizontalAlignment="Stretch"
                               Icon="{ui:SymbolIcon Play24}" Height="44" FontSize="14" FontWeight="Bold"
                               IsEnabled="{Binding Selected, Converter={StaticResource NotNullConverter}}"/>
                </Grid>
            </Border>
        </Grid>

        <ProgressBar Grid.Row="2" Height="3" IsIndeterminate="True" Margin="0,8,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
