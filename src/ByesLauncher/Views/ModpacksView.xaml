<UserControl x:Class="ByesLauncher.Views.ModpacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:Button Content="Refresh" Command="{Binding RefreshCommand}" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,0"/>
            <ui:Button Content="Sync Selected" Appearance="Primary" Command="{Binding SyncCommand}"
                       Icon="{ui:SymbolIcon ArrowDownload24}"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Modpacks}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"    Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="100"/>
                <DataGridTextColumn Header="Size"    Binding="{Binding TotalSize}" Width="120"/>
                <DataGridTextColumn Header="Id"      Binding="{Binding Id}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <ProgressBar Grid.Row="2" Height="6" Margin="0,8,0,0"
                     Value="{Binding ProgressFraction}" Minimum="0" Maximum="1"/>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Opacity="0.8" Margin="0,4,0,0"/>
    </Grid>
</UserControl>
