<ui:FluentWindow x:Class="ByesLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:v="clr-namespace:ByesLauncher.Views"
        Title="Backyard Esports Launcher"
        Height="820" Width="1320"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Backyard Esports — Arma 2 &amp; DayZ Launcher"/>

        <!-- Header band: logo slot + brand + top-right link bar -->
        <Border Grid.Row="1" Margin="12,12,12,0" Padding="14,10" CornerRadius="6"
                BorderBrush="#3A3A3A" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#1A2B3A"/>
                    <GradientStop Offset="1" Color="#161616"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Grid DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,16,0">
                    <Border CornerRadius="10" BorderBrush="#4CC2FF" BorderThickness="1.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#0E2533"/>
                                <GradientStop Offset="1" Color="#072030"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="BYES" FontSize="16" FontWeight="Bold" Foreground="#4CC2FF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image Source="pack://application:,,,/Assets/logo.png" Stretch="Uniform">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <Trigger Property="Source" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>

                <!-- Top-right link bar -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <ui:HyperlinkButton Content="DISCORD" NavigateUri="https://discord.gg/Kng9hBA9V8"
                                        Padding="8,4" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="|" Opacity="0.3" VerticalAlignment="Center" Margin="2,0"/>
                    <ui:HyperlinkButton Content="WEBSITE" NavigateUri="https://byes.nz"
                                        Padding="8,4" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="|" Opacity="0.3" VerticalAlignment="Center" Margin="2,0"/>
                    <ui:HyperlinkButton Content="MODS" NavigateUri="https://byes.nz/mods"
                                        Padding="8,4" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="|" Opacity="0.3" VerticalAlignment="Center" Margin="2,0"/>
                    <ui:HyperlinkButton Content="SUPPORT" NavigateUri="https://byes.nz/launcher"
                                        Padding="8,4" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Backyard Esports" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Arma 2 &amp; DayZ Standalone Launcher" Opacity="0.7"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" Margin="12,12,12,0" SelectionChanged="OnTabChanged" x:Name="MainTabs">
            <TabItem Header="Arma 2 Servers" x:Name="ServersTab">
                <v:ServersView DataContext="{Binding Servers}"/>
            </TabItem>
            <TabItem Header="Favorites" x:Name="FavoritesTab">
                <v:FavoritesView DataContext="{Binding Favorites}"/>
            </TabItem>
            <TabItem Header="History" x:Name="HistoryTab">
                <v:HistoryView DataContext="{Binding History}"/>
            </TabItem>
            <TabItem Header="Modpacks">
                <v:ModpacksView DataContext="{Binding Modpacks}"/>
            </TabItem>
            <TabItem Header="Profiles">
                <v:ProfilesView DataContext="{Binding Profiles}"/>
            </TabItem>
            <TabItem Header="Settings">
                <v:SettingsView DataContext="{Binding Settings}"/>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="3" Background="#0D0D0D" Foreground="#C7C7C7">
            <StatusBarItem><Ellipse Width="8" Height="8" Fill="#74E08A"/></StatusBarItem>
            <StatusBarItem><TextBlock Text="{Binding StatusText}"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock Text="byes.nz" Opacity="0.7"/></StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding VersionLabel}" Opacity="0.6" FontFamily="Consolas"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
