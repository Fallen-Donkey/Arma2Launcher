<ui:FluentWindow x:Class="ByesLauncher.Views.Dialogs.DownloadProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Syncing modpack"
        Height="320" Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Sync modpack"/>

        <StackPanel Grid.Row="1" Margin="24,8,24,0">
            <TextBlock Text="{Binding Headline}" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" Margin="0,2,0,16"/>

            <ProgressBar Height="8" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/>
            <Grid Margin="0,6,0,12">
                <TextBlock Text="{Binding ProgressLine}" FontFamily="Consolas" FontSize="12" Opacity="0.8"/>
                <TextBlock Text="{Binding EtaLine}" FontFamily="Consolas" FontSize="12" Opacity="0.8"
                           HorizontalAlignment="Right"/>
            </Grid>

            <Border Background="#141414" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="10,6">
                <TextBlock Text="{Binding CurrentFile}" FontFamily="Consolas" FontSize="12"
                           TextTrimming="CharacterEllipsis" Opacity="0.9"/>
            </Border>

            <TextBlock Text="{Binding StatusLine}" Margin="0,10,0,0" Opacity="0.65" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,16">
            <ui:Button Content="Cancel" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
