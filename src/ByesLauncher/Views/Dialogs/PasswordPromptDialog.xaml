<ui:FluentWindow x:Class="ByesLauncher.Views.Dialogs.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Server Password"
        Height="240" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Server requires a password"/>

        <StackPanel Grid.Row="1" Margin="20,12,20,0">
            <TextBlock Text="{Binding ServerName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="This server is password-protected. Enter the password to join."
                       Opacity="0.7" Margin="0,4,0,12" TextWrapping="Wrap"/>
            <PasswordBox Name="PwBox" Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,12,20,16">
            <ui:Button Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
            <ui:Button Content="Join" Appearance="Primary" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
