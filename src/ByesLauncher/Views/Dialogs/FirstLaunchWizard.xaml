<ui:FluentWindow x:Class="ByesLauncher.Views.Dialogs.FirstLaunchWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Welcome — Backyard Esports Launcher"
        Height="520" Width="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="First-time setup"/>

        <Grid Grid.Row="1" Margin="32,16,32,8">
            <!-- Page 1: Welcome + Arma 2 OA path -->
            <StackPanel Name="PageWelcome">
                <TextBlock Text="Welcome to Backyard Esports" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Let's get you set up to play. This takes about 30 seconds."
                           Opacity="0.7" Margin="0,4,0,20"/>

                <TextBlock Text="Step 1 of 2 — Find your Arma 2 install" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12">
                    The launcher syncs mods directly into the Arma 2 Operation Arrowhead folder
                    next to <Run FontFamily="Consolas">arma2oa.exe</Run>. We tried to auto-detect it.
                </TextBlock>

                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="Browse…" Click="Browse_Click" Margin="8,0,0,0"/>
                    <ui:TextBox Name="ArmaPathBox"
                                PlaceholderText="C:\Program Files (x86)\Steam\steamapps\common\Arma 2 Operation Arrowhead"/>
                </DockPanel>

                <Border Margin="0,12,0,0" Padding="12" CornerRadius="4"
                        BorderBrush="#3A3A3A" BorderThickness="1" Background="#1A1A1A">
                    <TextBlock Name="PathStatus" TextWrapping="Wrap" FontSize="12" Opacity="0.85"/>
                </Border>
            </StackPanel>

            <!-- Page 2: Profile -->
            <StackPanel Name="PageProfile" Visibility="Collapsed">
                <TextBlock Text="Step 2 of 2 — Pick a profile" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12">
                    Arma 2 stores your settings, controls, and identity per-profile. Pick an existing
                    profile or create a new one. You can change this later in the Profiles tab.
                </TextBlock>

                <RadioButton Name="UseExisting" Content="Use existing profile" IsChecked="True" Margin="0,4"/>
                <ComboBox Name="ProfileList" Margin="24,0,0,8"/>

                <RadioButton Name="CreateNew" Content="Create new profile" Margin="0,8,0,4"/>
                <ui:TextBox Name="NewProfileBox" PlaceholderText="Profile name" Margin="24,0,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,16">
            <ui:Button Name="BackBtn" Content="Back" Click="Back_Click" IsEnabled="False" Margin="0,0,8,0"/>
            <ui:Button Name="NextBtn" Content="Next" Appearance="Primary" Click="Next_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
