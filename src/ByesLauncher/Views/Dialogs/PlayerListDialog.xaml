<ui:FluentWindow x:Class="ByesLauncher.Views.Dialogs.PlayerListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Players"
        Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Players"/>

        <StackPanel Grid.Row="1" Margin="20,12,20,8">
            <TextBlock Text="{Binding ServerName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Margin="20,4,20,4" Background="#141414" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
            <Grid>
                <DataGrid ItemsSource="{Binding Players}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          RowBackground="Transparent" AlternatingRowBackground="#181818"
                          Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name"  Binding="{Binding Name}"            Width="*"/>
                        <DataGridTextColumn Header="Score" Binding="{Binding Score}"           Width="80"/>
                        <DataGridTextColumn Header="Time"  Binding="{Binding PlayTimeDisplay}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="No players online — or this server hides its roster."
                           Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding EmptyVisibility}"/>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Height="3"
                             Visibility="{Binding LoadingVisibility}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,16">
            <ui:Button Content="Refresh" Click="Refresh_Click" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,0"/>
            <ui:Button Content="Close" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
