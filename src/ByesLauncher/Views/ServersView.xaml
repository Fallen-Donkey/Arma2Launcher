<UserControl x:Class="ByesLauncher.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top search row -->
        <Border Grid.Row="0" Padding="8" Margin="0,0,0,8"
                Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <ui:Button DockPanel.Dock="Left" Content="Refresh All" Command="{Binding RefreshCommand}"
                           Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Opacity="0.7"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <ui:TextBox PlaceholderText="Search by name, map, or gametype..."
                            Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}"/>
            </DockPanel>
        </Border>

        <!-- Three-column main: filter sidebar | server list | details -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left: filter panel -->
            <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#3A3A3A"
                    BorderThickness="1" CornerRadius="4" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="FILTERS" FontSize="11" FontWeight="Bold"
                                   Foreground="#4CC2FF" Opacity="0.9" Margin="0,0,0,12"/>

                        <TextBlock Text="Hide" FontSize="10" Opacity="0.6" Margin="0,0,0,4"/>
                        <CheckBox Content="Empty"           IsChecked="{Binding HideEmpty}"      Margin="0,2"/>
                        <CheckBox Content="Full"            IsChecked="{Binding HideFull}"       Margin="0,2"/>
                        <CheckBox Content="Password"        IsChecked="{Binding HidePassworded}" Margin="0,2"/>
                        <CheckBox Content="Offline / no resp"   IsChecked="{Binding HideOffline}"    Margin="0,2"/>
                        <CheckBox Content="No info"         IsChecked="{Binding HideNoInfo}"     Margin="0,2"/>
                        <CheckBox Content="Non-BattlEye only" IsChecked="{Binding BattleEyeOnly}"  Margin="0,2"/>

                        <TextBlock Text="Map" FontSize="10" Opacity="0.6" Margin="0,16,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableMaps}" SelectedItem="{Binding MapFilter}"/>

                        <TextBlock Text="Mod / Gametype" FontSize="10" Opacity="0.6" Margin="0,12,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableMods}" SelectedItem="{Binding ModFilter}"/>

                        <ui:Button Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                                   Icon="{ui:SymbolIcon Eraser24}"
                                   HorizontalAlignment="Stretch" Margin="0,16,0,0"/>

                        <Border Margin="0,20,0,0" Padding="10" CornerRadius="4"
                                BorderBrush="#4CC2FF" BorderThickness="1" Background="#0E2533">
                            <StackPanel>
                                <TextBlock Text="★ BYES servers" FontSize="11" FontWeight="Bold"
                                           Foreground="#4CC2FF" Margin="0,0,0,4"/>
                                <TextBlock Text="Always pinned to top of the list, regardless of filters."
                                           FontSize="10" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

            <!-- Middle: server list -->
            <DataGrid Grid.Column="2"
                      ItemsSource="{Binding ServersView}"
                      SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      RowBackground="Transparent" AlternatingRowBackground="#181818"
                      Background="#141414" BorderBrush="#3A3A3A"
                      Sorting="OnSorting"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsByes}" Value="True">
                                <Setter Property="Background" Value="#0E2533"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <!-- Selection highlight wins over IsByes tint. WPF resolves
                                 the last matching trigger, so this trigger comes after
                                 IsByes intentionally — we want the selected row clearly
                                 distinct even when it's a BYES row. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1F4A6E"/>
                                <Setter Property="BorderBrush" Value="#4CC2FF"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Join server" Command="{Binding JoinCommand}"/>
                        <MenuItem Header="Refresh this server" Command="{Binding RefreshSingleCommand}"/>
                        <MenuItem Header="Toggle favorite" Command="{Binding ToggleFavoriteCommand}"/>
                        <MenuItem Header="Show players" Command="{Binding ShowPlayersCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="32">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value=""/>
                                            <Setter Property="Foreground" Value="#888"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsByes}" Value="True">
                                                    <Setter Property="Text" Value="★"/>
                                                    <Setter Property="Foreground" Value="#4CC2FF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Text" Value="★"/>
                                                    <Setter Property="Foreground" Value="#FFB84C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Server Name" Binding="{Binding Name}"          SortMemberPath="Name"     Width="*"/>
                    <DataGridTextColumn Header="Map"         Binding="{Binding Map}"           SortMemberPath="Map"      Width="120"/>
                    <DataGridTextColumn Header="Players"     Binding="{Binding PlayersDisplay}" SortMemberPath="Players" Width="80"/>
                    <DataGridTextColumn Header="Ping"        Binding="{Binding PingDisplay}"   SortMemberPath="Ping"     Width="60"/>
                    <DataGridTextColumn Header="Gametype"    Binding="{Binding Gametype}"      SortMemberPath="Gametype" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch"/>

            <!-- Right: details panel -->
            <Border Grid.Column="4" Background="#1A1A1A" BorderBrush="#3A3A3A"
                    BorderThickness="1" CornerRadius="4" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Visibility="{Binding Selected, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding Selected.Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Selected.Endpoint}" Opacity="0.6" Margin="0,2,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:Button Command="{Binding RefreshSingleCommand}" Icon="{ui:SymbolIcon ArrowSync24}"
                                       ToolTip="Re-query this server" Padding="6,4" Margin="0,0,4,0"/>
                            <ui:Button Icon="{ui:SymbolIcon Star24}" ToolTip="Toggle favorite"
                                       Command="{Binding ToggleFavoriteCommand}" Padding="6,4" Margin="0,0,4,0"/>
                            <ui:Button Icon="{ui:SymbolIcon People24}" ToolTip="Show player list"
                                       Command="{Binding ShowPlayersCommand}" Padding="6,4"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Map"      Opacity="0.6" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.Map}" Margin="12,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Players"  Opacity="0.6" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.PlayersDisplay}" Margin="12,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Gametype" Opacity="0.6" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.Gametype}" Margin="12,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Version"  Opacity="0.6" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.Version}" Margin="12,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ping"     Opacity="0.6" Margin="0,2"/>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="12,2">
                                <TextBlock Text="{Binding Selected.PingDisplay}"/>
                                <TextBlock Text=" ms" Opacity="0.6"
                                           Visibility="{Binding Selected.Ping, Converter={StaticResource ZeroToVisibleConverter}, ConverterParameter=invert}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Modpack"  Opacity="0.6" Margin="0,2"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Selected.ModpackDisplay}" Foreground="#4CC2FF" Margin="12,2" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.RowSpan="2"
                               Text="Select a server to see details."
                               Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Selected, Converter={StaticResource NullToVisibleConverter}}"/>

                    <!-- JOIN button: label flips to "JOINING…" while a join is in
                         flight (held for ≥5s minimum so the user actually reads it).
                         IsEnabled is driven entirely by Style triggers — both must
                         pass: a server must be selected AND no join may be running.
                         Don't set IsEnabled inline; local values beat style triggers. -->
                    <ui:Button Grid.Row="2" Appearance="Primary"
                               Content="{Binding IsJoining, Converter={StaticResource JoinButtonContentConverter}, ConverterParameter=JOIN SERVER}"
                               Command="{Binding JoinCommand}" HorizontalAlignment="Stretch"
                               Icon="{ui:SymbolIcon Play24}"
                               Height="44" FontSize="14" FontWeight="Bold">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJoining}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                </Grid>
            </Border>
        </Grid>

        <ProgressBar Grid.Row="2" Height="3" IsIndeterminate="True" Margin="0,8,0,0"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
    </Grid>
</UserControl>
