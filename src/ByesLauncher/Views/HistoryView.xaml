<UserControl x:Class="ByesLauncher.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:Button Content="Refresh" Command="{Binding RefreshCommand}" Icon="{ui:SymbolIcon ArrowSync24}"/>
            <ui:Button Content="Clear all" Command="{Binding ClearCommand}" Appearance="Danger"
                       Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0"/>
            <TextBlock Text="Last 25 servers you joined. Click rejoin to sync mods + connect again."
                       Opacity="0.7" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  RowBackground="Transparent" AlternatingRowBackground="#181818"
                  Background="#141414" BorderBrush="#3A3A3A">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Server Name" Binding="{Binding Name}"      Width="*"/>
                <DataGridTextColumn Header="Map"         Binding="{Binding Map}"       Width="120"/>
                <DataGridTextColumn Header="Modpack"     Binding="{Binding ModpackId}" Width="160"/>
                <DataGridTextColumn Header="IP:Port"     Binding="{Binding Endpoint}"  Width="160"/>
                <DataGridTextColumn Header="Joined"      Binding="{Binding JoinedAt}"  Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <ui:Button Content="Rejoin" Appearance="Primary" Command="{Binding RejoinCommand}"
                       Icon="{ui:SymbolIcon Play24}"/>
        </StackPanel>
    </Grid>
</UserControl>
