<UserControl x:Class="ByesLauncher.Views.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding FavoritesView}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  RowBackground="Transparent" AlternatingRowBackground="#181818"
                  Background="#141414" BorderBrush="#3A3A3A">
            <DataGrid.Columns>
                <DataGridTextColumn Header="★"           Binding="{Binding ''}" Width="32"/>
                <DataGridTextColumn Header="Server Name" Binding="{Binding Name}"            Width="*"/>
                <DataGridTextColumn Header="Map"         Binding="{Binding Map}"             Width="120"/>
                <DataGridTextColumn Header="Players"     Binding="{Binding PlayersDisplay}"  Width="80"/>
                <DataGridTextColumn Header="Ping"        Binding="{Binding Ping}"            Width="60"/>
                <DataGridTextColumn Header="IP:Port"     Binding="{Binding Endpoint}"        Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <ui:Button Content="Join" Appearance="Primary" Command="{Binding JoinCommand}" Icon="{ui:SymbolIcon Play24}"/>
            <ui:Button Content="Unfavorite" Command="{Binding UnfavoriteCommand}" Icon="{ui:SymbolIcon StarOff24}" Margin="8,0,0,0"/>
            <TextBlock Text="Tip: refresh the Servers tab to see live player counts here too."
                       Opacity="0.6" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
