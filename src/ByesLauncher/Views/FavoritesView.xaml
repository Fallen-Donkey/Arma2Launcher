<UserControl x:Class="ByesLauncher.Views.FavoritesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar: refresh + search. Mirrors the Servers tab so the
             experience between the two stays consistent. -->
        <Border Grid.Row="0" Padding="8" Margin="0,0,0,8"
                Background="#1F1F1F" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
            <DockPanel LastChildFill="True">
                <ui:Button DockPanel.Dock="Left" Content="Refresh" Command="{Binding RefreshCommand}"
                           Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,0"/>
                <ui:TextBox PlaceholderText="Search favorites by name, map, or gametype..."
                            Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Search24}"/>
            </DockPanel>
        </Border>

        <!-- Two-column main: list | details. Same shape as the Servers tab so
             selecting a row updates the right pane in the expected place. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding FavoritesView}"
                      SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      RowBackground="Transparent" AlternatingRowBackground="#181818"
                      Background="#141414" BorderBrush="#3A3A3A"
                      MouseDoubleClick="OnRowDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsByes}" Value="True">
                                <Setter Property="Background" Value="#0E2533"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1F4A6E"/>
                                <Setter Property="BorderBrush" Value="#4CC2FF"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Join server" Command="{Binding JoinCommand}"/>
                        <MenuItem Header="Remove from favorites" Command="{Binding UnfavoriteCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Server Name" Binding="{Binding Name}"            Width="*"/>
                    <DataGridTextColumn Header="Map"         Binding="{Binding Map}"             Width="120"/>
                    <DataGridTextColumn Header="Players"     Binding="{Binding PlayersDisplay}"  Width="80"/>
                    <DataGridTextColumn Header="Ping"        Binding="{Binding PingDisplay}"     Width="60"/>
                    <DataGridTextColumn Header="IP:Port"     Binding="{Binding Endpoint}"        Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

            <!-- Right: details panel — same field layout as the Servers tab so
                 muscle memory transfers between tabs. -->
            <Border Grid.Column="2" Background="#1A1A1A" BorderBrush="#3A3A3A"
                    BorderThickness="1" CornerRadius="4" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Visibility="{Binding Selected, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding Selected.Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Selected.Endpoint}" Opacity="0.6" Margin="0,2,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Map"      Opacity="0.6" Margin="0,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.Map}" Margin="12,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Players"  Opacity="0.6" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.PlayersDisplay}" Margin="12,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Gametype" Opacity="0.6" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.Gametype}" Margin="12,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Ping"     Opacity="0.6" Margin="0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.PingDisplay}" Margin="12,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Modpack"  Opacity="0.6" Margin="0,2"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.ModpackDisplay}" Foreground="#4CC2FF" Margin="12,2" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="0" Grid.RowSpan="2"
                               Text="Select a favorite to see details."
                               Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Selected, Converter={StaticResource NullToVisibleConverter}}"/>

                    <StackPanel Grid.Row="2" Orientation="Vertical">
                        <ui:Button Appearance="Primary"
                                   Content="{Binding IsJoining, Converter={StaticResource JoinButtonContentConverter}, ConverterParameter=JOIN SERVER}"
                                   Command="{Binding JoinCommand}" HorizontalAlignment="Stretch"
                                   Icon="{ui:SymbolIcon Play24}"
                                   Height="44" FontSize="14" FontWeight="Bold">
                            <ui:Button.Style>
                                <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsJoining}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Content="Remove from favorites" Command="{Binding UnfavoriteCommand}"
                                   Icon="{ui:SymbolIcon StarOff24}" HorizontalAlignment="Stretch"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
